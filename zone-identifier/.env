# ── Pivot Detection ────────────────────────────────────────────────────────
# How many points price must move to close a range bar (noise filter)
RANGE_SIZE=8.0

# How many points price must reverse from a swing extreme to confirm a pivot
REVERSAL_THR=30.0

# ── Zone Detection ─────────────────────────────────────────────────────────
# KDE bandwidth — tighter = sharper/more zones, wider = fewer/smoother zones
BANDWIDTH=7.0

# Half-width of each S/R zone band in points (zone spans price ± this value)
ZONE_HW=17.5

# How long a pivot stays "fresh" — halves in weight every N minutes
HALF_LIFE_MIN=120.0

# Max number of S/R zones to show
TOP_N=10

# ── Dashboard / Console ────────────────────────────────────────────────────
# How often (seconds) to reprint zones between bar closes (0 = bar-close only)
ZONE_INTERVAL=30

# ── WebSocket (live_sr.py) ─────────────────────────────────────────────────
WS_HOST=localhost
WS_PORT=8086
WS_PATH=/ws
DASH_PORT=8087
RECONNECT_DELAY=3

# ── Strategy (sr_pattern_strategy.py) ──────────────────────────────────────
# Supertrend filter
ST_PERIOD=10
ST_MULT=3.0

# Trailing stop
TRAIL_START_PTS=10.0
TRAIL_STEP_PTS=30.0

# Max trades allowed per calendar day
MAX_TRADES_PER_DAY=3
